{
  "AvatarForms HTML Boilerplate": {
    "prefix": "afhtml",
    "body": [
      "<!doctype html>",
      "<html lang=\"en\">",
      "  <head>",
      "    <meta charset=\"UTF-8\" />",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
      "    <title>${1:AvatarForms - Page Title}</title>",
      "    <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>",
      "    <link href=\"https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.css\" rel=\"stylesheet\"/>",
      "    <link href=\"css/styles.css\" rel=\"stylesheet\"/>",
      "  </head>",
      "  <body class=\"min-h-screen flex flex-col\">",
      "    <nav id=\"navbar-container\" class=\"fixed top-0 w-full z-50\"></nav>",
      "",
      "    <!-- Layout Container -->",
      "    <div class=\"flex flex-1 pt-16\">",
      "      <aside id=\"sidebar-container\" class=\"w-64 flex-shrink-0 self-stretch\"></aside>",
      "",
      "      <!-- Main content area -->",
      "      <main class=\"flex-1 w-full max-w-[1400px] mx-auto py-6 px-4 sm:px-6 lg:px-8\">",
      "        <div id=\"breadcrumbs-container\" class=\"mb-6\"></div>",
      "        $0",
      "      </main>",
      "    </div>",
      "",
      "    <div id=\"footer-placeholder\"></div>",
      "",
      "    <script src=\"https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js\"></script>",
      "    <script>",
      "      const breadcrumbPaths = {",
      "        'index.html': [{ title: 'Home', href: 'index.html' }],",
      "        'requirements.html': [",
      "          { title: 'Home', href: 'index.html' },",
      "          { title: 'Requirements', href: 'requirements.html' }",
      "        ],",
      "        'appendices.html': [",
      "          { title: 'Home', href: 'index.html' },",
      "          { title: 'Requirements', href: 'requirements.html' },",
      "          { title: 'Appendices', href: 'appendices.html' }",
      "        ],",
      "        'ui-showcase.html': [",
      "          { title: 'Home', href: 'index.html' },",
      "          { title: 'UI Showcase', href: 'ui-showcase.html' }",
      "        ]",
      "      };",
      "",
      "      function addCurrentBreadcrumb() {",
      "        const breadcrumbsList = document.getElementById('breadcrumbs-list');",
      "        if (!breadcrumbsList) return;",
      "",
      "        const currentPath = window.location.pathname.split('/').pop() || 'index.html';",
      "        const trail = breadcrumbPaths[currentPath] || [",
      "          { title: 'Home', href: 'index.html' },",
      "          { title: 'Page' }",
      "        ];",
      "",
      "        if (currentPath === 'index.html') return;",
      "",
      "        trail.slice(1).forEach((crumb, index) => {",
      "          const isLast = index === trail.slice(1).length - 1;",
      "          const listItem = document.createElement('li');",
      "          listItem.className = 'inline-flex items-center gap-2 text-body';",
      "",
      "          const separator = `",
      "            <svg class=\"w-3 h-3 text-body\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 6 10\">",
      "              <path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"m1 9 4-4-4-4\"/>",
      "            </svg>",
      "          `;",
      "",
      "          if (isLast || !crumb.href) {",
      "            listItem.innerHTML = `${separator}<span aria-current=\"page\">${crumb.title}</span>`;",
      "          } else {",
      "            listItem.innerHTML = `${separator}<a href=\"${crumb.href}\" class=\"hover:text-fg-brand\">${crumb.title}</a>`;",
      "          }",
      "",
      "          breadcrumbsList.appendChild(listItem);",
      "        });",
      "      }",
      "",
      "      fetch('components/navbar.html')",
      "        .then(response => response.text())",
      "        .then(data => {",
      "          document.getElementById('navbar-container').innerHTML = data;",
      "        })",
      "        .catch(error => console.error('Error loading navbar:', error));",
      "",
      "      fetch('components/sidebar.html')",
      "        .then(response => response.text())",
      "        .then(data => {",
      "          document.getElementById('sidebar-container').innerHTML = data;",
      "        })",
      "        .catch(error => console.error('Error loading sidebar:', error));",
      "",
      "      fetch('components/breadcrumbs.html')",
      "        .then(response => response.text())",
      "        .then(data => {",
      "          document.getElementById('breadcrumbs-container').innerHTML = data;",
      "          addCurrentBreadcrumb();",
      "        })",
      "        .catch(error => console.error('Error loading breadcrumbs:', error));",
      "",
      "      fetch('components/footer.txt')",
      "        .then(response => response.text())",
      "        .then(data => {",
      "          document.getElementById('footer-placeholder').innerHTML = data;",
      "        })",
      "        .catch(error => console.error('Error loading footer:', error));",
      "",
      "    </script>",
      "  </body>",
      "</html>"
    ],
    "description": "AvatarForms page scaffold with imports, navbar/sidebar/breadcrumb layout, and shared component loaders"
  },
  "AvatarForms Dynamic Tabs": {
    "prefix": "aftabs",
    "body": [
      "<section class=\"af-stack\">",
      "  <ul class=\"af-tabs\" id=\"${1:requirements}-tabs\" role=\"tablist\" aria-label=\"${2:Requirements} tabs\">",
      "    <li class=\"me-2\" role=\"presentation\">",
      "      <button class=\"af-tab-link\" id=\"${1:requirements}-profile-tab\" data-tabs-target=\"#${1:requirements}-profile-panel\" type=\"button\" role=\"tab\" aria-controls=\"${1:requirements}-profile-panel\" aria-selected=\"true\">${3:Profile}</button>",
      "    </li>",
      "    <li class=\"me-2\" role=\"presentation\">",
      "      <button class=\"af-tab-link\" id=\"${1:requirements}-dashboard-tab\" data-tabs-target=\"#${1:requirements}-dashboard-panel\" type=\"button\" role=\"tab\" aria-controls=\"${1:requirements}-dashboard-panel\" aria-selected=\"false\">${4:Dashboard}</button>",
      "    </li>",
      "    <li class=\"me-2\" role=\"presentation\">",
      "      <button class=\"af-tab-link\" id=\"${1:requirements}-settings-tab\" data-tabs-target=\"#${1:requirements}-settings-panel\" type=\"button\" role=\"tab\" aria-controls=\"${1:requirements}-settings-panel\" aria-selected=\"false\">${5:Settings}</button>",
      "    </li>",
      "    <li role=\"presentation\">",
      "      <button class=\"af-tab-link af-tab-link-disabled\" type=\"button\" role=\"tab\" aria-selected=\"false\" disabled>${6:Disabled}</button>",
      "    </li>",
      "  </ul>",
      "",
      "  <div id=\"${1:requirements}-tab-content\">",
      "    <div class=\"af-tab-panel\" id=\"${1:requirements}-profile-panel\" role=\"tabpanel\" aria-labelledby=\"${1:requirements}-profile-tab\">",
      "      <div class=\"af-card\">",
      "        <h3 class=\"af-card-title\">${3:Profile} content</h3>",
      "        <p class=\"af-card-text\">${7:Add tab content here.}</p>",
      "      </div>",
      "    </div>",
      "    <div class=\"hidden af-tab-panel\" id=\"${1:requirements}-dashboard-panel\" role=\"tabpanel\" aria-labelledby=\"${1:requirements}-dashboard-tab\">",
      "      <div class=\"af-card\">",
      "        <h3 class=\"af-card-title\">${4:Dashboard} content</h3>",
      "        <p class=\"af-card-text\">${8:Add tab content here.}</p>",
      "      </div>",
      "    </div>",
      "    <div class=\"hidden af-tab-panel\" id=\"${1:requirements}-settings-panel\" role=\"tabpanel\" aria-labelledby=\"${1:requirements}-settings-tab\">",
      "      <div class=\"af-card\">",
      "        <h3 class=\"af-card-title\">${5:Settings} content</h3>",
      "        <p class=\"af-card-text\">${9:Add tab content here.}</p>",
      "      </div>",
      "    </div>",
      "  </div>",
      "</section>",
      "",
      "<script>",
      "  function initAfTabs(tabListId, panelContainerId) {",
      "    const tabList = document.getElementById(tabListId);",
      "    const panelContainer = document.getElementById(panelContainerId);",
      "    if (!tabList || !panelContainer) return;",
      "",
      "    const tabs = Array.from(tabList.querySelectorAll('[role=\\\"tab\\\"][data-tabs-target]'));",
      "    const panels = Array.from(panelContainer.querySelectorAll('[role=\\\"tabpanel\\\"]'));",
      "    if (!tabs.length || !panels.length) return;",
      "",
      "    const activateTab = (selectedTab) => {",
      "      const targetSelector = selectedTab.getAttribute('data-tabs-target');",
      "      if (!targetSelector) return;",
      "",
      "      tabs.forEach((tab) => {",
      "        const isActive = tab === selectedTab;",
      "        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');",
      "        tab.tabIndex = isActive ? 0 : -1;",
      "      });",
      "",
      "      panels.forEach((panel) => panel.classList.add('hidden'));",
      "",
      "      const activePanel = panelContainer.querySelector(targetSelector);",
      "      if (activePanel) activePanel.classList.remove('hidden');",
      "    };",
      "",
      "    tabs.forEach((tab) => {",
      "      tab.addEventListener('click', () => activateTab(tab));",
      "    });",
      "",
      "    const initiallySelected = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true') || tabs[0];",
      "    activateTab(initiallySelected);",
      "  }",
      "",
      "  initAfTabs('${1:requirements}-tabs', '${1:requirements}-tab-content');",
      "</script>"
    ],
    "description": "Dynamic in-page tabs with AvatarForms styling, gradient active/hover bar, and JS panel toggle"
  }
}
